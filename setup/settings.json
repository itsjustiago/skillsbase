{
  "enabledPlugins": {
    "superpowers@superpowers-dev": true,
    "sanctum@claude-night-market": true,
    "leyline@claude-night-market": true,
    "abstract@claude-night-market": true,
    "conserve@claude-night-market": true,
    "impeccable@impeccable": true,
    "frontend-design@claude-code-plugins": true,
    "watch@claude-video": true
  },
  "extraKnownMarketplaces": {
    "superpowers-dev":      { "source": { "source": "github", "repo": "obra/superpowers" } },
    "impeccable":           { "source": { "source": "github", "repo": "pbakaus/impeccable" } },
    "claude-night-market":  { "source": { "source": "github", "repo": "athola/claude-night-market" } },
    "claude-video":         { "source": { "source": "github", "repo": "bradautomates/claude-video" } },
    "claude-code-plugins":  { "source": { "source": "github", "repo": "anthropics/claude-code" } }
  },
  "voiceEnabled": true,
  "voice": { "enabled": true, "mode": "hold" },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": { "type": "command", "command": "bash ~/.claude/statusline.sh" }
}
